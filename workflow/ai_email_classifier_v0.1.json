    {
      "parameters": {
        "jsCode": "const testCase = $('test case').first().json;\n\nconst expectedIntent = testCase.expected_intent;\nconst predictedIntent = $json.intent;\n\nconst expectedOrderId = testCase.expected_order_id;\nconst predictedOrderId = $json.order_id;\n\nconst intentCorrect = expectedIntent === predictedIntent;\n\nconst normalizeOrderId = (id) => {\n  if (id === null || id === undefined || id === \"\") {\n    return null;\n  }\n\n  return String(id).trim().toUpperCase();\n};\n\nconst normalizedExpectedOrderId = normalizeOrderId(expectedOrderId);\nconst normalizedPredictedOrderId = normalizeOrderId(predictedOrderId);\n\nconst orderIdCorrect =\n  normalizedExpectedOrderId === normalizedPredictedOrderId;\n\nreturn {\n  json: {\n    ...$json,\n\n    expected_intent: expectedIntent,\n    predicted_intent: predictedIntent,\n\n    expected_order_id: expectedOrderId,\n    predicted_order_id: predictedOrderId,\n\n    intent_correct: intentCorrect,\n    order_id_correct: orderIdCorrect\n  }\n};"
      },

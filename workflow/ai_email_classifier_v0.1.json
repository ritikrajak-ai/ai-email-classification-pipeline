        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\":\"You are a customer email classification system. Classify the customer's intent using only the allowed intent values. Return ONLY a valid JSON object. Do not include markdown, explanations, or additional text. The JSON must contain exactly these fields: intent, confidence, order_id. The intent field must be one of: tracking, refund, return, replacement, cancellation, other. The confidence field must be a number between 0 and 1. The order_id field must be a string containing the order ID, or null if no order ID is present.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.email }}\"\n    }\n  ]\n} ",
        "options": {}
      },

    {
      "parameters": {
        "jsCode": "const { intent, confidence, order_id } = $json;\n\nconst allowedIntents = [\n  \"tracking\",\n  \"refund\",\n  \"return\",\n  \"replacement\",\n  \"cancellation\",\n  \"other\"\n];\n\nconst errors = [];\n\n// -------------------------\n// 1. Intent validation\n// -------------------------\n\nif (typeof intent !== \"string\") {\n  errors.push(\"intent must be a string\");\n}\n\nif (!allowedIntents.includes(intent)) {\n  errors.push(\"intent is not an allowed value\");\n}\n\n// -------------------------\n// 2. Confidence validation\n// -------------------------\n\nif (typeof confidence !== \"number\") {\n  errors.push(\"confidence must be a number\");\n} else if (confidence < 0 || confidence > 1) {\n  errors.push(\"confidence must be between 0 and 1\");\n}\n\n// -------------------------\n// 3. Order ID schema validation\n// -------------------------\n\nif (order_id !== null && typeof order_id !== \"string\") {\n  errors.push(\"order_id must be a string or null\");\n}\n\n// -------------------------\n// 4. Order ID business validation\n// -------------------------\n\nif (order_id !== null && typeof order_id === \"string\") {\n  const orderIdPattern = /^ORD-\\d{5}$/;\n\n  if (!orderIdPattern.test(order_id.toUpperCase())) {\n    errors.push(\"order_id has invalid format\");\n  }\n}\n\n// -------------------------\n// 5. Final validation result\n// -------------------------\n\nif (errors.length > 0) {\n  throw new Error(\n    `AI output validation failed: ${errors.join(\", \")}`\n  );\n}\n\n// -------------------------\n// 6. Valid output\n// -------------------------\n\nreturn [{\n  json: {\n    valid: true,\n    intent,\n    confidence,\n    order_id\n  }\n}];"
      },
